/* DIEL pins, ADC inputs, MUX order and UF2 flash layout. */
#include <nordic/nrf52840_qiaa.dtsi>
#include <common/nordic/nrf52840_uf2_boot_mode.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zephyr,code-partition = &code_partition;
        zmk,kscan = &ec_scan;
        zmk,battery = &alkaline_battery;
    };

    ec_scan: ec_scan {
        compatible = "prec,ec-kscan";
        wakeup-source;
        row-pins = <4 5 6 7>;
        mux-select-pins = <8 27 12>;
        mux-enable-pins = <15 16>;
        column-channels = <3 0 1 2 5 4 3 0 1 2 5 4>;
        discharge-pin = <41>; /* P1.09: absolute Nordic GPIO number */
        amplifier-pin = <14>;
        battery-enable-pin = <17>;
        wake-pin = <45>; /* P1.13 */
        ec-analog-input = <7>;
        battery-analog-input = <5>;
    };

    alkaline_battery: battery {
        compatible = "prec,alkaline-battery";
    };

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <4>;
        columns = <12>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
        >;
    };
};

&gpio0 { status = "okay"; };
&gpio1 { status = "okay"; };
&gpiote { status = "okay"; };

/* These peripherals are owned exclusively by the EC driver, not Zephyr ADC/counter. */
&adc { status = "disabled"; };
&timer2 { status = "disabled"; };

&reg1 { regulator-initial-mode = <NRF5X_REG_MODE_DCDC>; };

/* P0.18 is the SW301 reset button. The SoC startup code writes UICR once if needed. */
&uicr { gpio-as-nreset; };

zephyr_udc0: &usbd { status = "okay"; };

&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;
        sd_partition: partition@0 { reg = <0x0 0x26000>; };
        code_partition: partition@26000 { reg = <0x26000 0xc6000>; };
        storage_partition: partition@ec000 { reg = <0xec000 0x8000>; };
        boot_partition: partition@f4000 { reg = <0xf4000 0xc000>; };
    };
};
