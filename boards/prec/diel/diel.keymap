/* Default DIEL keymap, ported from the wired PREC. */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        prec_lt: prec_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <180>;
            quick-tap-ms = <180>;
            bindings = <&mo>, <&kp>;
        };
        prec_macro_0: prec_macro_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <10>;
            wait-ms = <10>;
            bindings = <&kp LS(N9)>, <&kp LS(N0)>, <&kp LEFT>;
        };
        prec_macro_1: prec_macro_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <10>;
            wait-ms = <10>;
            bindings = <&kp LS(LBKT)>, <&kp LS(RBKT)>, <&kp LEFT>;
        };
        prec_macro_2: prec_macro_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <10>;
            wait-ms = <10>;
            bindings = <&kp LBKT>, <&kp RBKT>, <&kp LEFT>;
        };
    };
    combos {
        compatible = "zmk,combos";
        prec_combo_0 {
            timeout-ms = <50>;
            key-positions = <19 20>;
            layers = <0 6 7>;
            bindings = <&prec_macro_0>;
        };
        prec_combo_1 {
            timeout-ms = <50>;
            key-positions = <7 8>;
            layers = <0 4 6 7>;
            bindings = <&prec_macro_1>;
        };
        prec_combo_2 {
            timeout-ms = <50>;
            key-positions = <31 32>;
            layers = <0 2 4 6 7>;
            bindings = <&prec_macro_2>;
        };
        /* Add wireless controls without changing the captured layer bindings. */
        wireless_controls {
            timeout-ms = <50>;
            key-positions = <34 46>; /* physical Up + Down */
            layers = <1 2>; /* hold Space or Backspace first */
            bindings = <&mo 8>;
            slow-release;
        };
    };
    keymap {
        compatible = "zmk,keymap";
        base {
            bindings = <
                &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp MINUS
                &kp LCTRL  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp ENTER
                &kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp UP  &kp SLASH
                &kp ESC  &kp LGUI  &kp LALT  &kp CAPS  &prec_lt 3 LANG2  &prec_lt 1 SPACE  &prec_lt 2 BSPC  &prec_lt 4 LANG1  &mo 5  &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };
        numbers {
            bindings = <
                &kp BSLH  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp GRAVE
                &trans  &kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)  &kp LS(N6)  &kp LS(N7)  &kp LS(N8)  &kp LS(N9)  &kp LS(N0)  &kp EQUAL
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp SQT  &trans  &trans  &kp C_VOL_UP  &trans
                &bootloader  &trans  &trans  &trans  &trans  &none  &trans  &trans  &trans  &trans  &kp C_VOL_DN  &kp C_MUTE
            >;
        };
        shift_numbers {
            bindings = <
                &trans  &kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)  &kp LS(N6)  &kp LS(N7)  &kp LS(N8)  &kp LS(N9)  &kp LS(N0)  &kp DELETE
                &trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp C_VOL_UP  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp C_VOL_DN  &kp C_MUTE
            >;
        };
        symbols {
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LS(LBKT)  &kp LS(RBKT)  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &kp SQT  &kp LS(N9)  &kp LS(N0)  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LBKT  &kp RBKT  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
        function {
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &kp F12  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
        keypad {
            bindings = <
                &trans  &kp KP_NUMLOCK  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MINUS  &trans  &trans  &kp PRINTSCREEN  &kp SCROLLLOCK  &kp PAUSE_BREAK  &trans
                &trans  &trans  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS  &trans  &trans  &kp INSERT  &kp HOME  &kp PG_UP  &trans
                &trans  &trans  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_EQUAL  &trans  &trans  &kp DELETE  &kp END  &kp PG_DN  &trans
                &trans  &trans  &kp KP_N0  &kp KP_DOT  &kp KP_DIVIDE  &kp KP_MULTIPLY  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
        reserved6 {
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
        reserved7 {
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
        connection {
            bindings = <
                &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR  &out OUT_USB  &out OUT_BLE  &studio_unlock  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
